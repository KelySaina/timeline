# Copy to .env before the first `docker compose up`.

# --- database ---
POSTGRES_DB=timeline
POSTGRES_USER=timeline
POSTGRES_PASSWORD=change-me-in-production

# --- api ---
# 32+ characters. Generate one: openssl rand -base64 48
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
# true behind HTTPS (required for cookies in production)
COOKIE_SECURE=false

# --- photo storage (MinIO) ---
# Root credentials stay inside the minio + minio-init services.
MINIO_ROOT_USER=timeline-root
MINIO_ROOT_PASSWORD=change-me-too-in-production
# The API only ever gets this key, scoped to the bucket below by infra/minio/photos-policy.json.
S3_BUCKET=timeline-photos
S3_ACCESS_KEY_ID=timeline-api
S3_SECRET_ACCESS_KEY=change-me-as-well-in-production

# --- notifications (web push) ---
# Optional. Without all three the app runs exactly as before and hides the notifications switch.
# Generate a pair:  ./scripts/vapid-keys.sh    (setup.sh also fills these in if they are missing)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who a push service should contact about this deployment. mailto: or https:.
VAPID_SUBJECT=

# --- routing (production) ---
# Hostname the reverse proxy answers for; setup.sh --domain fills it in. Empty = no proxy.
APP_DOMAIN=
# What sits in front, and therefore which compose files a deploy uses:
#   caddy-host  a Caddy on the host (apt/systemd) reaching 127.0.0.1:$WEB_PORT. The base
#               compose file is all that runs; this project owns no TLS and no overlay.
#               Install the site block with: sudo ./scripts/caddy-site.sh --install
#   traefik     the shared Traefik already on the box, via docker-compose.prod.yml.
PROXY_MODE=caddy-host
# Read in traefik mode only — the docker network whichever stack owns Traefik created.
PROXY_NETWORK=izyah

# --- ports on the host ---
# The interface the web container is published on. 127.0.0.1 whenever a proxy fronts this:
# on 0.0.0.0 the app also answers on :$WEB_PORT in plain http, around the proxy and its TLS.
# setup.sh --domain sets this to 127.0.0.1 for you.
WEB_BIND=0.0.0.0
WEB_PORT=4280
# Everything below is published only by docker-compose.dev.yml, bound to 127.0.0.1
API_PORT=4281
DB_PORT=55433
MINIO_API_PORT=9400
MINIO_CONSOLE_PORT=9401
