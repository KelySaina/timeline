# Host development for the API (outside Docker). Compose injects its own values instead.
DATABASE_URL=postgres://timeline:change-me-in-production@127.0.0.1:55433/timeline
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
PORT=4281
COOKIE_SECURE=false

# Photo storage. 'local' needs nothing else; 's3' points at the MinIO published by the dev overlay.
STORAGE_DRIVER=local
UPLOAD_DIR=./storage/uploads

# Used by `npm run test:s3`, which exercises the S3 driver against MinIO. Root credentials here
# because the suite creates its own throwaway bucket; the app itself uses the scoped key.
S3_ENDPOINT=http://127.0.0.1:9400
S3_BUCKET=timeline-photos-test
S3_ACCESS_KEY_ID=timeline-root
S3_SECRET_ACCESS_KEY=change-me-too-in-production
